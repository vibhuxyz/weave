--- ./apps/desktop/src/features/files/components/CodeView.tsx
+++ ./apps/desktop/src/features/files/components/CodeView.tsx
@@ -1,11 +1,42 @@
+import { useEffect, useState } from "react";
+import type { BundledLanguage, ThemedToken } from "shiki";
+import { highlightCode } from "@/shared/ui/ai-elements/code-block";
+import { cn } from "@/shared/lib";
+
+const EXT_LANG: Record<string, BundledLanguage> = {
+  ts: "typescript",
+  tsx: "tsx",
+  js: "javascript",
+  jsx: "jsx",
+  json: "json",
+  css: "css",
+  html: "html",
+  md: "markdown",
+  py: "python",
+  yaml: "yaml",
+  yml: "yaml",
+  xml: "xml",
+  sql: "sql",
+  sh: "shell",
+  bash: "shell"
+};
+
 export function CodeView({ content, filename }: { readonly content: string; readonly filename?: string }) {
   const lineCount = content.split("\n").length;
   const numbers = Array.from({ length: lineCount }, (_, index) => index + 1).join("\n");
+
+  const [tokenized, setTokenized] = useState<{ tokens: ThemedToken[][] } | null>(null);
+
+  useEffect(() => {
+    const ext = filename?.split(".").pop()?.toLowerCase();
+    const lang = (ext ? EXT_LANG[ext] : undefined) ?? "text";
+    const cached = highlightCode(content, lang as BundledLanguage, (res) => {
+      setTokenized(res as { tokens: ThemedToken[][] });
+    });
+    if (cached) {
+      setTokenized(cached as { tokens: ThemedToken[][] });
+    }
+  }, [content, filename]);
+
+  // Shiki font styles bitwise constants
+  // oxlint-disable-next-line eslint(no-bitwise)
+  const isItalic = (fontStyle?: number) => fontStyle && (fontStyle & 1);
+  // oxlint-disable-next-line eslint(no-bitwise)
+  const isBold = (fontStyle?: number) => fontStyle && (fontStyle & 2);
+  // oxlint-disable-next-line eslint(no-bitwise)
+  const isUnderline = (fontStyle?: number) => fontStyle && (fontStyle & 4);
+
   return (
     <div className="flex min-w-0 font-mono text-xs leading-6">
       <pre aria-hidden className="shrink-0 select-none border-agent-border border-r px-3 text-right text-agent-text-faint">{numbers}</pre>
-      <pre aria-label={filename} className="min-w-0 flex-1 overflow-x-auto px-3 text-agent-text">{content}</pre>
+      <pre aria-label={filename} className="min-w-0 flex-1 overflow-x-auto px-3 text-agent-text">
+        {tokenized ? (
+          tokenized.tokens.map((lineTokens, i) => (
+            <div key={i} className="table-row">
+              {lineTokens.map((token, j) => (
+                <span
+                  key={j}
+                  style={{ color: token.color }}
+                  className={cn(
+                    isItalic(token.fontStyle) && "italic",
+                    isBold(token.fontStyle) && "font-bold",
+                    isUnderline(token.fontStyle) && "underline",
+                  )}
+                >
+                  {token.content}
+                </span>
+              ))}
+              {lineTokens.length === 0 && <span>{"\n"}</span>}
+            </div>
+          ))
+        ) : (
+          content
+        )}
+      </pre>
     </div>
   );
 }
