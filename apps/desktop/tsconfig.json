{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@berd/protocol": ["../../packages/protocol/src/index.ts"],
      "@berd/protocol/*": ["../../packages/protocol/src/*"],
      "@berd/agent": ["../../packages/agent/src/index.ts"],
      "@berd/core": ["../../packages/core/src/index.ts"],
      "@berd/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["src", "server", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "../../reference"]
}
