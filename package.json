{
  "name": "weave",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "bun run --filter desktop dev",
    "dev:server": "bun run --filter desktop server",
    "tauri": "bun run --filter desktop tauri",
    "build": "bun run --filter desktop build",
    "build:app": "bun run --filter desktop tauri build && cp -a apps/desktop/src-tauri/target/release/bundle/macos/*.app ./",
    "typecheck": "bun run --workspaces typecheck"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "node-pty"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "agy-acp@0.5.2": "patches/agy-acp@0.5.2.patch"
  }
}
