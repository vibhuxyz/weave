{
  "name": "weave",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm -F desktop dev",
    "dev:server": "pnpm -F desktop server",
    "tauri": "pnpm -F desktop tauri",
    "build": "pnpm -F desktop build",
    "build:app": "pnpm -F desktop tauri build && cp -a apps/desktop/src-tauri/target/release/bundle/macos/*.app ./",
    "weave": "pnpm -F @weave/cli start",
    "eval": "pnpm -F @weave/cli start eval",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
